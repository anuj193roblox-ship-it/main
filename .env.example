# Copy to .env.local and fill in your own values. Never commit .env.local.
# Public values are safe for the browser. Everything else is server-only.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_ and never import it from client code.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string, used only by `npm run db:migrate` on your machine. Never by the app.
# Supabase dashboard > Connect > Session pooler. Replace [YOUR-PASSWORD] with the database password.
DATABASE_URL=

# Optional: path to the Supabase CA certificate (Project Settings > Database > SSL), so db:migrate
# verifies the server certificate. Without it the connection is still encrypted but not verified.
DATABASE_SSL_CA=

# Public address of the app, e.g. https://nurra.example. Used in email links and the Origin check.
# Required in production. Defaults to http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=

# Cloudflare Turnstile. Leave both empty in development to use Cloudflare's test keys.
# Required in production (the test keys are refused there).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Set to true only if CAPTCHA protection is turned on in Supabase Auth with the same Turnstile
# secret. Then Supabase checks the token and the app forwards it instead of checking it itself.
SUPABASE_VERIFIES_CAPTCHA=

# Random string of at least 32 characters for signing the inactivity and reset cookies.
# Required in production. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SESSION_SECRET=

# Claude for patient check-ins (server only). Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Optional. Default: claude-sonnet-5-5
ANTHROPIC_MODEL_CHECKIN=
# Model calls per patient per 24 hours, to protect credits. Default: 300
CHECKIN_DAILY_MODEL_CAP=
# Set to true only once WhatsApp alerts are delivered (Stage S6). Until then, the red-flag reply
# does not say that anyone is being told. Default: false
ALERTS_DELIVERY_ENABLED=

# Two-step sign-in (TOTP) for clinician and admin. true or false.
# Default: true in production, false in development.
REQUIRE_MFA=

# Set to true to show internal pages such as /style in production, and to allow the first
# verified user to claim the seeded demo household. Leave empty otherwise.
NEXT_PUBLIC_DEMO_MODE=

# Set to 1 to run the live household A/B test against your Supabase project.
# It creates and then deletes two temporary users and households.
RLS_LIVE_TEST=
